{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTLauncher",
  "version": "0.1.0",
  "identifier": "com.lighting-team.rtlauncher",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:51515",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "RTLauncher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Game",
    "targets": ["appimage", "deb"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://gitcode.com/bubulaladdi/RTLauncher/releases/download/%E5%B7%A5%E5%85%B7/latest.json"
      ],
      "pubkey": "RWSUdzbR0TRn/H799eUvXxXQ5YOhzaYpk6gdbrvJtVb4yO6gwsH3Whiy"
    }
  }
}
